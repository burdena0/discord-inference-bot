# copy to .env and add your bot token
DISCORD_TOKEN=your-bot-token

# chat and embedding models
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_URL=http://127.0.0.1:11434
EMBED_MODEL=nomic-embed-text

# chat memory and context size
NUM_CTX=8192
MAX_HISTORY=10
AUTO_RESET_MINUTES=20
KEEP_ALIVE=1h

# extra roles allowed to change settings; names or ids, comma separated
COMMAND_ROLES=

# extra users allowed to shut down or start up the bot; ids, comma separated
SHUTDOWN_USERS=

# default personality
SYSTEM_PROMPT="You're a friendly, witty assistant hanging out in this Discord. Keep replies short and conversational unless someone asks for detail. Use Discord markdown."

# funny score needed for big ascii replies; 11 turns it off
FUNNY_MIN=9
